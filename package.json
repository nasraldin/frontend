{
  "name": "ajrly-frontend",
  "version": "0.3.8",
  "type": "module",
  "description": "Frontend application build with solidjs",
  "scripts": {
    "dev": "vinxi dev",
    "build": "vinxi build",
    "start": "vinxi start",
    "dev:inspect": "NODE_OPTIONS='--trace-warnings --inspect' vinxi dev",
    "build:check": "npx tsc --noEmit --skipLibCheck",
    "build:dictionary": "node scripts/build-dictionary.mjs",
    "i18n-check": "npx @lingual/i18n-check@latest --source en --locales messages --unused",
    "test": "vitest run",
    "test-watch": "vitest",
    "test-ui": "vitest --ui",
    "webhint": "npx hint http://localhost:3000",
    "lint": "pnpm style && pnpm format && pnpm eslint",
    "lint:check": "pnpm style:check && pnpm format:check && pnpm eslint:check",
    "format": "prettier --write --list-different .",
    "format:check": "prettier --check .",
    "pretty-quick": "pretty-quick",
    "style": "stylelint --quiet --fix src/**/*.css",
    "style:check": "stylelint --quiet src/**/*.css",
    "eslint": "eslint --quiet --fix '**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}'",
    "eslint:check": "eslint '**/*.{js,mjs,cjs,ts,mts,cts,jsx,tsx}'",
    "clean": "sh scripts/clean.sh",
    "security:audit": "pnpm audit",
    "security:audit-fix": "pnpm audit --fix",
    "packages:upgrade": "pnpm up --latest",
    "docker:build": "docker compose up -d --build --force-recreate",
    "docker:down": "docker compose down",
    "prepare": "node .husky/install.mjs",
    "postinstall": "node scripts/patch-vinxi-robust.js",
    "knip": "knip"
  },
  "dependencies": {
    "@ark-ui/solid": "5.27.1",
    "@formatjs/intl-localematcher": "0.6.2",
    "@googlemaps/markerclusterer": "2.6.2",
    "@keycloak/keycloak-admin-client": "26.4.2",
    "@mdx-js/mdx": "3.1.1",
    "@solid-mediakit/auth": "3.1.3",
    "@solid-primitives/i18n": "2.2.1",
    "@solidjs/meta": "0.29.4",
    "@solidjs/router": "0.15.3",
    "@solidjs/start": "1.2.0",
    "@tanstack/solid-query": "5.90.9",
    "@upstash/ratelimit": "2.0.7",
    "@upstash/redis": "1.35.6",
    "@vinxi/plugin-mdx": "3.7.2",
    "cache-manager": "7.2.4",
    "cacheable-request": "13.0.13",
    "clsx": "2.1.1",
    "date-fns": "4.1.0",
    "defu": "6.1.4",
    "duo-icons": "1.1.4",
    "feed": "5.1.0",
    "framer-motion": "12.23.24",
    "isomorphic-dompurify": "2.31.0",
    "keycloak-js": "26.2.1",
    "lodash": "4.17.21",
    "lodash-es": "4.17.21",
    "lucide-solid": "0.552.0",
    "marked": "16.4.1",
    "mime-types": "3.0.1",
    "nanoid": "5.1.6",
    "negotiator": "1.0.0",
    "nuqs": "2.7.2",
    "pino": "10.1.0",
    "pino-pretty": "13.1.2",
    "reading-time": "1.5.0",
    "sanitize-filename": "1.6.3",
    "sharp": "0.34.4",
    "solid-js": "1.9.10",
    "solid-mdx": "0.0.7",
    "solid-theme-provider": "0.10.1",
    "start-oauth": "1.3.0",
    "tailwind-variants": "3.1.1",
    "unstorage": "1.17.2",
    "uuid": "13.0.0",
    "valibot": "1.1.0",
    "vinxi": "0.5.8"
  },
  "devDependencies": {
    "@commitlint/cli": "20.1.0",
    "@commitlint/config-conventional": "20.0.0",
    "@eslint/eslintrc": "3.3.1",
    "@eslint/js": "9.39.1",
    "@ianvs/prettier-plugin-sort-imports": "4.7.0",
    "@solidjs/testing-library": "0.8.10",
    "@tailwindcss/forms": "0.5.10",
    "@tailwindcss/typography": "0.5.19",
    "@tailwindcss/vite": "4.1.16",
    "@tanstack/eslint-plugin-query": "5.91.2",
    "@tanstack/solid-query-devtools": "5.90.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/user-event": "14.6.1",
    "@types/eslint-plugin-tailwindcss": "3.17.0",
    "@types/lodash": "4.17.20",
    "@types/lodash-es": "4.17.12",
    "@types/mime-types": "3.0.1",
    "@types/negotiator": "0.6.4",
    "@types/node": "24.10.0",
    "@vitest/ui": "4.0.6",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.4",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-solid": "0.14.5",
    "eslint-plugin-tailwindcss": "4.0.0-beta.0",
    "globals": "16.5.0",
    "husky": "9.1.7",
    "jsdom": "27.1.0",
    "knip": "5.67.1",
    "lint-staged": "16.2.6",
    "patch-package": "8.0.1",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.7.1",
    "pretty-quick": "4.2.2",
    "stylelint": "16.25.0",
    "stylelint-config-standard": "39.0.1",
    "stylelint-config-tailwindcss": "1.0.0",
    "stylelint-order": "7.0.0",
    "tailwind-merge": "3.3.1",
    "tailwind-scrollbar": "4.0.2",
    "tailwindcss": "4.1.16",
    "ts-node": "10.9.2",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.3",
    "vite": "7.1.12",
    "vite-plugin-pwa": "1.1.0",
    "vite-plugin-solid": "2.11.10",
    "vitest": "4.0.6",
    "workbox-window": "7.3.0"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=10.x",
    "node": ">=22.x"
  },
  "author": "Nasr Aldin <ns@nasraldin.com> (https://nasraldin.com)",
  "license": "UNLICENSED",
  "private": true,
  "repository": "https://github.com/nasraldin/frontend.git",
  "bugs": "https://github.com/nasraldin/frontend/issues",
  "keywords": [
    "frontend",
    "solidjs",
    "solid-start",
    "ssr",
    "ssg"
  ],
  "overrides": {
    "@mdx-js/mdx": "3.1.1",
    "cookie": ">=0.7.0",
    "esbuild": ">=0.25.0",
    "vite": "7.1.11"
  }
}
